# ─────────────────────────────────────────────────────────────────────────────
# boxincloud — configuration
#
# Seules DATABASE_URL et BOXINCLOUD_SECRET_KEY sont obligatoires.
# Tout le reste a un défaut raisonnable ; les backends de stockage et les
# bibliothèques se configurent dans l'interface, pas ici.
# ─────────────────────────────────────────────────────────────────────────────

# ── Obligatoire ──────────────────────────────────────────────────────────────

DATABASE_URL=postgres://boxincloud:boxincloud@localhost:5432/boxincloud?sslmode=disable

# Chiffre les identifiants des backends de stockage en base (AES-256-GCM).
# 32 octets en hexadécimal. Générer avec :  openssl rand -hex 32
#
# ⚠️  Sa perte rend les backends de stockage illisibles.
#     Sauvegardez-la SÉPARÉMENT de la base de données.
BOXINCLOUD_SECRET_KEY=

# ── Serveur ──────────────────────────────────────────────────────────────────

BOXINCLOUD_ADDR=:8080
BOXINCLOUD_PUBLIC_URL=http://localhost:8080

# development | production
# En development : logs lisibles, CORS permissif, pas de cache sur les assets.
BOXINCLOUD_ENV=development

# debug | info | warn | error
BOXINCLOUD_LOG_LEVEL=info
# json | text  (text est plus lisible en développement)
BOXINCLOUD_LOG_FORMAT=text

# ── Base de données ──────────────────────────────────────────────────────────

BOXINCLOUD_DB_MAX_CONNS=20
BOXINCLOUD_DB_MIN_CONNS=2
# Applique les migrations au démarrage. Laisser à true sauf déploiement contrôlé.
BOXINCLOUD_DB_AUTO_MIGRATE=true

# ── Jobs asynchrones (River, sur PostgreSQL) ─────────────────────────────────

# Workers d'indexation exécutés dans ce process.
BOXINCLOUD_JOBS_ENABLED=true
BOXINCLOUD_JOBS_MAX_WORKERS=8

# ── Authentification ─────────────────────────────────────────────────────────

# Signe les jetons d'accès. Générer avec :  openssl rand -hex 32
# Si vide, une clé est dérivée de BOXINCLOUD_SECRET_KEY.
BOXINCLOUD_JWT_SECRET=
BOXINCLOUD_ACCESS_TOKEN_TTL=15m
BOXINCLOUD_REFRESH_TOKEN_TTL=720h

# ── Cache dérivé (pages transcodées, vignettes) ──────────────────────────────

# Répertoire du cache local. Intégralement reconstructible : le supprimer ne
# perd aucune donnée utilisateur.
BOXINCLOUD_CACHE_DIR=./data/cache
# Taille maximale avant éviction LRU.
BOXINCLOUD_CACHE_MAX_SIZE=10GB

# ── Téléversement ────────────────────────────────────────────────────────────

# Taille maximale d'un fichier déposé depuis l'interface.
#
# Une intégrale numérisée dépasse couramment les 500 Mo. La limite s'applique au
# flux lui-même, pas seulement à la taille annoncée : un client ne peut pas
# annoncer un petit fichier et en envoyer un énorme.
#
# Zéro lève la limite, ce qui n'est raisonnable que sur un serveur dont on
# maîtrise tous les comptes.
BOXINCLOUD_UPLOAD_MAX_SIZE=2GB

# ── Recherche fédérée et métadonnées ─────────────────────────────────────────

# Autorise l'instance à joindre les bases de métadonnées publiques — Open
# Library et Internet Archive — pour proposer des fiches lors d'une correction
# d'album.
#
# Mettre à false sur une instance délibérément coupée d'Internet : les requêtes
# n'y feraient qu'échouer, et le rapprochement rendra simplement une liste vide.
#
# Ces bases DÉCRIVENT seulement. Elles ne fournissent aucun fichier, et leurs
# réponses n'apparaissent jamais dans les résultats de recherche.
BOXINCLOUD_METADATA_ENABLED=true

# Clé d'API Google Books. Facultative, et le fournisseur est simplement ABSENT
# sans elle.
#
# Ce n'est pas de la prudence excessive : sans clé, le quota de Google est
# partagé par adresse IP et s'épuise en quelques centaines de requêtes. Un
# fournisseur qui échoue une fois sur deux fait douter de la fonctionnalité
# entière au lieu de manquer proprement.
#
# Open Library et Internet Archive couvrent l'essentiel sans aucune clé.
BOXINCLOUD_GOOGLE_BOOKS_KEY=

# Répertoire de gabarits de scraping écrits par l'opérateur.
#
# Certains sites du domaine public n'ont ni API ni flux OPDS : ils ne se lisent
# qu'en analysant leur HTML. Un gabarit décrit où regarder — sélecteurs CSS,
# miroirs, débit — sans qu'il faille recompiler quoi que ce soit.
#
# Les gabarits LIVRÉS voyagent dans le binaire et sont revus comme du code. Ce
# répertoire-ci charge EN PLUS les vôtres : l'intranet d'une médiathèque, un
# catalogue local. Ils ne sont revus par personne, et n'engagent que vous — le
# critère d'admission reste celui des sources livrées : la diffusion des œuvres
# doit être autorisée.
#
# Chemin ABSOLU de préférence : un chemin relatif se résout contre le répertoire
# depuis lequel le serveur est lancé, pas contre la racine du dépôt. Le serveur
# journalise le chemin résolu quand il ne le trouve pas.
#
# N'entourez PAS la valeur de guillemets : `make` les garderait dans la valeur.
# Les espaces passent très bien sans eux, avec make comme avec docker compose.
#
# Vide, aucun gabarit d'opérateur n'est chargé. Format : docs/06-gabarits-scraper.md
#
# Un exemple qui fonctionne, sur un site réel, est fourni dans
# deploy/scraper-templates/ — pointez cette variable dessus pour le voir à
# l'œuvre dans l'écran de configuration.
BOXINCLOUD_SCRAPER_TEMPLATES_DIR=

# ── Développement uniquement ─────────────────────────────────────────────────
# Utilisés par docker-compose.dev.yml et les tests d'intégration.

# Ports hôte des dépendances. À changer si ces ports sont déjà occupés sur
# votre machine — pensez alors à répercuter sur DATABASE_URL et DEV_MINIO_ENDPOINT.
BOXINCLOUD_DEV_POSTGRES_PORT=5432
BOXINCLOUD_DEV_MINIO_PORT=9000
BOXINCLOUD_DEV_MINIO_CONSOLE_PORT=9001

DEV_MINIO_ENDPOINT=localhost:9000
DEV_MINIO_ACCESS_KEY=boxincloud
DEV_MINIO_SECRET_KEY=boxincloud
DEV_MINIO_BUCKET=comics
DEV_MINIO_USE_SSL=false
