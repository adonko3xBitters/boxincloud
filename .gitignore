# Build artifacts
/bin/
/dist/
*.exe

# Le web compilé est embarqué dans le binaire ; seul le placeholder est versionné.
apps/server/web/dist/*
!apps/server/web/dist/index.html

# Env
.env
.env.local
*.local

# Go
*.test
*.out
/coverage.*

# Node
node_modules/
.next/
out/
*.tsbuildinfo

# Flutter / Dart
.dart_tool/
.packages
build/
*.g.dart.bak

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Local data — cache d'images et fichiers de travail, tous régénérables.
# Deux emplacements parce que le répertoire de cache est relatif au dossier de
# lancement : à la racine en usage normal, sous apps/server quand on lance le
# serveur depuis son propre module. Les chemins sont énumérés plutôt qu'une
# règle « data/ » globale, qui avalerait un jour la couche data de l'app Flutter.
/data/
/apps/server/data/
/tmp/
